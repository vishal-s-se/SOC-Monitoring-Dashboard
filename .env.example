# ==============================================================================
# SOC Monitor — Environment Variables Template (.env.example)
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or real secrets to source control.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
PROJECT_NAME="SOC Monitor"
VERSION="0.1.0"
DEBUG=false
HTTPS_ENABLED=false

# Database Configuration (REQUIRED)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# URL-encode special characters in your password (e.g., '@' as '%40', ':' as '%3A')
# Both backend and collector automatically convert 'postgresql://' to 'postgresql+asyncpg://'
DATABASE_URL=postgresql://soc_user:change_this_password@localhost:5432/soc_monitor

# Backend API Security
# Generate a cryptographically strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_random_32_character_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (Comma-separated, no trailing slashes)
# In production, specify your exact domain (wildcard * is rejected in production mode)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Collector Service Configuration
COLLECTOR_PORT=5000
# Used for legacy/master collector endpoints if configured
AGENT_SHARED_SECRET=change_this_to_another_random_secret_token

# Rate Limiting & WebSockets
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=5
EXPENSIVE_RATE_LIMIT_PER_MINUTE=120
WS_MAX_CONNECTIONS=50
WS_MAX_MESSAGE_BYTES=4096

# Initial Admin Bootstrap (Optional — leaves user creation to first-time setup if unset)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change_this_admin_password
# BOOTSTRAP_ADMIN_EMAIL=admin@example.local

# Frontend Configuration (Used by Next.js if overriding localhost defaults)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_COLLECTOR_URL=http://localhost:5000
